# Grant access to HP WMI devices to the victus group
SUBSYSTEM=="hwmon", KERNELS=="hp-wmi", GROUP="victus", MODE="0664"
SUBSYSTEM=="hwmon", KERNELS=="hp-wmi", ACTION=="add|change", RUN+="/bin/sh -c 'chgrp victus /sys%p/pwm1_enable /sys%p/fan*_target 2>/dev/null; chmod g+w /sys%p/pwm1_enable /sys%p/fan*_target 2>/dev/null'"
SUBSYSTEM=="hwmon", KERNELS=="hp-wmi", ATTR{fan1_input}=="?*", GROUP="victus", MODE="0444"
SUBSYSTEM=="hwmon", KERNELS=="hp-wmi", ATTR{fan2_input}=="?*", GROUP="victus", MODE="0444"

# Grant access to HP keyboard LEDs to the victus-backend group
SUBSYSTEM=="leds", KERNELS=="hp::kbd_backlight", ATTR{multi_intensity}=="?*", GROUP="victus", MODE="0664"
SUBSYSTEM=="leds", KERNELS=="hp::kbd_backlight", ATTR{brightness}=="?*", GROUP="victus", MODE="0664"

# Grant the victus group write access to the four-zone RGB files. The lighting
# animation repaints these every frame; without this each frame would have to
# fork sudo, which is both slow and noisy in the journal.
# The zone files are created by the driver's probe, which runs after the
# platform device's "add" event has already fired, so the rule also matches
# "bind" (sent once the driver is attached) and "change" (udevadm trigger).
SUBSYSTEM=="platform", KERNEL=="hp-wmi", ACTION=="add|bind|change", \
  RUN+="/bin/sh -c 'chgrp victus /sys/devices/platform/hp-wmi/rgb_zones/zone0* 2>/dev/null; chmod g+w /sys/devices/platform/hp-wmi/rgb_zones/zone0* 2>/dev/null'"
